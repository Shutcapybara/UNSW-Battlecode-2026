# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Local environments, editor state, and caches
.venv/
env/
.idea/
.DS_Store
*.swp
.cache/
.pytest_cache/

# Local build output
.unswbc-build/
unswbc/
build/
Testing/
/main

# Experiment output and replay files
/experiment_data/
/public_replays/
/replays/
*.replay
*.replay.gz
*.replay.zip
*.replay.json

# Local credentials
.battlecode-api-key

# Parquet outputs are ignored by default; shared run contributions are tracked.
*.parquet
!/game_stats/runs/*.parquet

# Other local game-statistics state
/game_stats/sources/
/game_stats/local/
/game_stats/.write.lock
/.game_stats.parquet*.tmp
/game_stats/runs/.*.tmp
