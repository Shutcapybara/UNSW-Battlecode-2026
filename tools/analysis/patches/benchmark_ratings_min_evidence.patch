+        established, panel_prior, shrunk_score = _mod.established, _mod.panel_prior, _mod.shrunk_score
+    except Exception:
+        def established(b, MIN=(60, 5, 8)):
+            return b.get('games', 0) >= MIN[0] and b.get('opponents', 0) >= MIN[1] and b.get('maps', 0) >= MIN[2]
+        _N0 = 60.0
+        _panel = [b['score'] for b in data['bots'] if established(b) and b.get('score') is not None]
+        _prior = sum(_panel) / len(_panel) if _panel else 0.5
+        def panel_prior(_bots, _p=_prior):
+            return _p
+        def shrunk_score(b, prior):
+            n = b.get('games') or 0
+            return prior + (b['score'] - prior) * n / (n + _N0)
+    prior = panel_prior(data['bots'])
