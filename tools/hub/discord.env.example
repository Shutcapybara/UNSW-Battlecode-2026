# Copy this file to ~/.config/jkshub/discord.env and chmod 600 it.
# Never commit the filled-in copy or paste the token into a public channel.
DISCORD_BOT_TOKEN=
JKS_DISCORD_ALLOWED_USER_IDS=
JKS_DISCORD_ALLOWED_GUILD_IDS=
JKS_DISCORD_ALLOWED_CHANNEL_IDS=
# Set true only when every member of the approved guild may toggle the hub.
JKS_DISCORD_ALLOW_ALL_USERS=false
