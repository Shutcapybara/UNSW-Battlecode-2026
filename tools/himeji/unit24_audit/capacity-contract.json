  "function": "def E(nbr, u, v, memo):\n    k = (u, v)\n    if k in memo: return memo[k]\n    seen = {u, v}; st = [v]; n = 0\n    while st and n < CAP:\n        c = st.pop()\n        for x in nbr.get(c, ()):\n            if x is None or x in seen: continue\n            seen.add(x); st.append(x); n += 1\n    memo[k] = n; return n",
